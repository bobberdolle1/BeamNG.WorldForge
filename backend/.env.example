# BeamNG.WorldForge configuration.
# Copy to .env and fill in what you need. Everything here is optional except a
# DEM source - without one, generation has no elevation data to work with.
#
# API keys can also be entered through the Settings page in the UI, where they
# are stored encrypted. Values set here take precedence over those.

# =============================================================================
# ELEVATION SOURCES (at least one required)
# =============================================================================

# -----------------------------------------------------------------------------
# OPENTOPOGRAPHY - simplest option, elevation only
# -----------------------------------------------------------------------------
# Free API key, registration takes a minute: https://opentopography.org/
# Provides: Copernicus DEM, SRTM, NASADEM, ALOS World 3D (30-90 m)
# Note: a key is required for the global datasets (mandatory since 2022).
OPENTOPOGRAPHY_API_KEY=

# -----------------------------------------------------------------------------
# SENTINEL HUB - elevation AND satellite imagery
# -----------------------------------------------------------------------------
# Free tier: 30,000 processing units/month. https://www.sentinel-hub.com/
# Provides: Copernicus DEM (30 m) + Sentinel-2 imagery (10 m RGB)
# Both values are required: the OAuth2 client-credentials flow needs the pair.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# =============================================================================
# IMAGERY SOURCES (optional - only used by AI segmentation)
# =============================================================================

# Azure Maps: high-resolution aerial imagery, no elevation.
# Free tier: 1,000 transactions/day.
# https://azure.microsoft.com/products/azure-maps/
AZURE_MAPS_SUBSCRIPTION_KEY=

# Bing Maps: retired by Microsoft. Use Azure Maps instead; this remains only
# for existing keys that still work.
BING_MAPS_API_KEY=

# =============================================================================
# GOOGLE EARTH ENGINE (optional - needs a Google Cloud service account)
# =============================================================================
# https://developers.google.com/earth-engine/guides/service_account
GEE_SERVICE_ACCOUNT_KEY=config/gee-key.json
GEE_PROJECT_ID=

# =============================================================================
# SERVER
# =============================================================================

# Bind address. 127.0.0.1 keeps the API on this machine; use 0.0.0.0 only when
# you intend to expose it (Docker, LAN). These endpoints have no authentication,
# so do not expose them to an untrusted network.
API_HOST=127.0.0.1
API_PORT=8000

# CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# STORAGE
# =============================================================================
# Relative paths resolve against the backend directory - or, in the standalone
# executable, next to the executable. Never against the current directory.
OUTPUT_DIR=output
TEMP_DIR=temp
CONFIG_DIR=config

# How long a finished job and its files are kept, in seconds (default 24h).
JOB_RETENTION_SECONDS=86400

# Generations allowed to run at once. Each holds a full DEM in memory, so raise
# this only if you have the RAM.
MAX_CONCURRENT_JOBS=2

# =============================================================================
# GENERATION DEFAULTS
# =============================================================================
# auto, sentinel_hub, opentopography, azure_maps, google_earth_engine
DEFAULT_DATA_SOURCE=auto
DEFAULT_IMAGE_SOURCE=sentinel_hub

# UI language: en or ru
UI_LANGUAGE=en

# =============================================================================
# AI SEGMENTATION (optional)
# =============================================================================
# Requires a running Ollama instance: https://ollama.ai/
# Without it generation still succeeds - it simply detects no roads or buildings.
OLLAMA_HOST=http://localhost:11434
OLLAMA_VL_MODEL=qwen3-vl:235b-cloud
OLLAMA_CODER_MODEL=qwen3-coder:480b-cloud
