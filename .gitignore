.DS_Store

# Project specific
backend/config/gee-key.json
backend/output/
backend/temp/

# Secrets - never commit these.
# settings.key is the Fernet key that decrypts user_settings.enc; committing it
# makes the "encrypted" API key storage worthless.
*.key
*.enc
backend/config/settings.key
backend/config/user_settings.enc
frontend/.env.local
frontend/.env.production.local

# Generated maps
*.zip
generated_maps/

# Docker
.docker/


# Frontend build output. backend/static is generated by build.py from
# frontend/dist; committing it means a stale copy is served whenever someone
# forgets to regenerate it after a frontend change.
frontend/dist/
backend/static/
